# Public Supabase configuration used by the browser bundle.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-side Supabase configuration used by SSR and server functions.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Server-only secret. Never expose this as a VITE_* variable.
SUPABASE_SERVICE_ROLE_KEY=
